# Database
DATABASE_URL=postgresql+asyncpg://postgres:1234@localhost:5432/auth_db
DB_ECHO=false
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Cache & Broker
REDIS_URL=redis://localhost:6379/0
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# JWT Security
JWT_SECRET_KEY=generate_a_secure_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS Allowed Origins
ALLOWED_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Brute-force Lockout Settings
FAILED_LOGIN_LIMIT=5
LOCKOUT_DURATION_SECONDS=1800

# OTP & Reset Expirations
OTP_EXPIRE_MINUTES=15
PASSWORD_RESET_EXPIRE_HOURS=1

# Outbox Publisher Settings
OUTBOX_POLL_INTERVAL_SECONDS=2.0
OUTBOX_BATCH_SIZE=50

# Kafka Optimizations
KAFKA_LINGER_MS=5

# Email verification: false = sign up and log in directly (default); true = require the emailed OTP first.
EMAIL_VERIFICATION_REQUIRED=false

# Email delivery. "console" logs OTPs/reset links and is ONLY allowed when ENVIRONMENT is development or test;
# the service refuses to start otherwise. Production/staging must use smtp.
EMAIL_SENDER=console
EMAIL_FROM=no-reply@granthan.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_USE_SSL=false
FRONTEND_BASE_URL=http://localhost:3000
# Optional dedicated key for hashing stored OTPs (defaults to JWT_SECRET_KEY)
OTP_HMAC_KEY=
EMAIL_MAX_ATTEMPTS=6

# Rate limits / lockout (per client IP + email; see app/cache/login_attempt_cache.py)
LOCKOUT_BASE_SECONDS=30
FAILED_LOGIN_EMAIL_CEILING=50
