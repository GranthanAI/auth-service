# Database
DATABASE_URL=postgresql+asyncpg://postgres:1234@localhost:5432/auth_db
DB_ECHO=false

# Cache & Broker
REDIS_URL=redis://localhost:6379/0
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# JWT Security
JWT_SECRET_KEY=generate_a_secure_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS Allowed Origins
ALLOWED_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Brute-force Lockout Settings
FAILED_LOGIN_LIMIT=5
LOCKOUT_DURATION_SECONDS=1800

# OTP & Reset Expirations
OTP_EXPIRE_MINUTES=15
PASSWORD_RESET_EXPIRE_HOURS=1

# Outbox Publisher Settings
OUTBOX_POLL_INTERVAL_SECONDS=2.0
OUTBOX_BATCH_SIZE=50

# Kafka Optimizations
KAFKA_LINGER_MS=5
